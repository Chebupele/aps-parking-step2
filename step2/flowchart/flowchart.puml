@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor white
skinparam classAttributeIconSize 0
hide circle
hide footbox
title Мониторинг парковок — алгоритм работы

|Модель и календарь|
start
:Пустой буфер, свободные приборы,\nУБ = УП = 0, now = 0;
|Камера|
:Запланировать первое ARRIVAL\nдля каждой камеры через U(a, b);
|Модель и календарь|
while (Следующее событие есть\nи его время <= T?) is (да)
  :Извлечь событие,\nnow = время события;
  if (Тип события?) then (ARRIVAL)
    |Камера|
    :Создать кадр и запланировать\nследующий приход через U(a, b)\n[ИБ, ИЗ2];
    |ДП|
    :Принять кадр,\nучесть GENERATED;
    |Буфер|
    :Найти свободное место\nпо кольцу от УБ [Д1ОЗ1];
    if (Место найдено?) then (нет)
      :Удалить самую старую заявку\nи вернуть её индекс [Д1ОО3];
      |ДП|
      :Учесть отказ вытесненной заявки;
    endif
    |Буфер|
    :Записать новый кадр\nв найденную или освобождённую ячейку;
    |ДП|
    :УБ = (index + 1) mod M,\nучесть BUFFERED;
  else (FINISH)
    |Прибор|
    :Завершить обработку,\nосвободить прибор;
    |Модель и календарь|
    :Учесть COMPLETED\nи время обслуживания;
  endif
  |ДВ|
  :Вызов dispatch после ARRIVAL / FINISH;
  while (Буфер не пуст?) is (да)
    :Найти свободный прибор по кольцу\nот УП, не более k проверок [Д2П2];
    if (Свободный прибор найден?) then (да)
      |Буфер|
      :Извлечь самый новый кадр\nи освободить ячейку [Д2Б2 — LIFO];
      |ДВ|
      :Учесть SELECTED;
      |Прибор|
      :Начать обслуживание,\nfinishTime = now + Exp(mu) [ПЗ1];
      |ДВ|
      :Добавить FINISH в календарь,\nучесть STARTED,\nУП = (j + 1) mod k;
    else (нет)
      :Оставить заявки в буфере\nи УП без изменений;
      break
    endif
  endwhile (нет)
  |Модель и календарь|
  :Показать состояние системы,\nкалендарь, журнал и указатели [ОД2];
endwhile (нет)
:Завершить наблюдение в T,\nвывести статистику и графики [ОР2];
stop
@enduml
